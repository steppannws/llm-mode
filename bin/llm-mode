#!/usr/bin/env bash
# bin/llm-mode — free RAM, run LM Studio server, restore on demand.
set -euo pipefail

STATE_DIR="${LLM_MODE_DIR:-$HOME/.llm-mode}"
STATE_FILE="$STATE_DIR/state.json"
LOG_FILE="$STATE_DIR/log"
DRY_RUN="${DRY_RUN:-0}"
RELAUNCH=0

mkdir -p "$STATE_DIR"

CFG_MODEL="qwen3-coder-30b-a3b"
CFG_PORT=1234
CFG_WIRED_MB=""        # empty = total RAM - CFG_RESERVE_MB
CFG_RESERVE_MB=4096    # RAM left for macOS when CFG_WIRED_MB is auto
CFG_WHITELIST_EXTRA="" # extra regex alternation, e.g. 'Ghostty|com\.mitchellh\.ghostty'
# shellcheck source=/dev/null
[[ -f "$STATE_DIR/config" ]] && source "$STATE_DIR/config"

WHITELIST_RE='sshd|loginwindow|WindowServer|mDNSResponder|notifyd|cfprefsd|systemstats|powerd|configd|distnoted|com\.apple\.Finder|LM Studio|lmstudio|lms|Terminal|iTerm'
[[ -n "$CFG_WHITELIST_EXTRA" ]] && WHITELIST_RE="$WHITELIST_RE|$CFG_WHITELIST_EXTRA"

log() { printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$*" >>"$LOG_FILE"; }
die() { echo "llm-mode: $*" >&2; exit 1; }
usage() { echo "usage: llm-mode {on|off|status|serve-stop} [--dry-run] [--relaunch]" >&2; exit 2; }

run() {
  log "RUN $*"
  if [[ $DRY_RUN -eq 1 ]]; then echo "[dry-run] $*"; else "$@"; fi
}

# total RAM minus reserve, unless CFG_WIRED_MB is set explicitly
wired_mb() {
  if [[ -n "$CFG_WIRED_MB" ]]; then echo "$CFG_WIRED_MB"; return; fi
  local total_mb
  total_mb=$(( $(sysctl -n hw.memsize) / 1048576 ))
  (( total_mb > CFG_RESERVE_MB )) || die "CFG_RESERVE_MB ($CFG_RESERVE_MB) >= total RAM (${total_mb}MB)"
  echo $(( total_mb - CFG_RESERVE_MB ))
}

# memory reclaimable without swapping: free + speculative + inactive pages
free_ram_mb() {
  vm_stat | awk '
    /page size of/      { for (i = 1; i <= NF; i++) if ($i == "of") ps = $(i + 1) }
    /^Pages free/        { n += $3 }
    /^Pages speculative/ { n += $3 }
    /^Pages inactive/    { n += $3 }
    END { printf "%.0f", n * ps / 1048576 }'
}

state_write() { printf '%s' "$1" >"$STATE_FILE"; log "state written"; }

state_get() {
  python3 -c "
import json, sys
try:
    d = json.load(open('$STATE_FILE'))
    v = d.get('$1', '')
    print('\n'.join(v) if isinstance(v, list) else v)
except Exception:
    pass"
}

# list visible (non-background) GUI apps, excluding whitelist
list_gui_apps() {
  osascript -e 'tell application "System Events" to get bundle identifier of (processes where background only is false)' \
    | tr ',' '\n' | sed 's/^ *//; s/ *$//' | grep -v '^$' \
    | grep -Ev "$WHITELIST_RE" || true
}

# enabled user launch agents, excluding whitelist, restricted to ones we can
# actually restore later (a plist under ~/Library/LaunchAgents) — see F6
list_agents() {
  local label
  while IFS= read -r label; do
    [[ -n "$label" ]] || continue
    [[ -f "$HOME/Library/LaunchAgents/$label.plist" ]] || continue
    echo "$label"
  done < <(launchctl list | awk 'NR>1 {print $3}' \
    | grep -Ev "$WHITELIST_RE" | grep -v '^-$' || true)
}

snapshot() {
  if [[ -f "$STATE_FILE" ]]; then
    local existing_dry
    existing_dry=$(state_get dry_run)
    if [[ $DRY_RUN -eq 0 ]] && [[ "$existing_dry" =~ ^(True|true|1)$ ]]; then
      log "replacing dry-run state"
      echo "replacing dry-run state"
    else
      log "snapshot skipped: existing state preserved"
      echo "existing state.json preserved (run 'off' to restore first)"
      return 0
    fi
  fi
  local apps agents prev
  apps=$(list_gui_apps | python3 -c 'import json,sys; print(json.dumps([l.strip() for l in sys.stdin if l.strip()]))')
  agents=$(list_agents | python3 -c 'import json,sys; print(json.dumps([l.strip() for l in sys.stdin if l.strip()]))')
  prev=$(sysctl -n iogpu.wired_limit_mb 2>/dev/null || echo 0)
  local dry_field=""
  [[ $DRY_RUN -eq 1 ]] && dry_field=', "dry_run": true'
  state_write "{\"apps\": $apps, \"agents\": $agents, \"wired_limit_prev\": \"$prev\", \"forced_kills\": []$dry_field}"
}

quit_apps() {
  local bid
  while IFS= read -r bid; do
    [[ -n "$bid" ]] || continue
    local running
    running=$(osascript -e "tell application \"System Events\" to (exists (processes whose bundle identifier is \"$bid\"))" 2>/dev/null || echo "false")
    [[ "$running" == "true" ]] || continue
    run osascript -e "tell application id \"$bid\" to quit" || log "quit failed: $bid"
  done < <(state_get apps)
  [[ $DRY_RUN -eq 1 ]] && return 0
  sleep 10
  # force-kill stragglers still running
  while IFS= read -r bid; do
    [[ -n "$bid" ]] || continue
    local pids
    pids=$(osascript -e "tell application \"System Events\" to get unix id of (processes whose bundle identifier is \"$bid\")" 2>/dev/null | tr -d ',' || true)
    [[ -n "$pids" ]] || continue
    for pid in $pids; do
      run kill -9 "$pid" || true
    done
    python3 -c "
import json
d = json.load(open('$STATE_FILE')); d['forced_kills'].append('$bid')
json.dump(d, open('$STATE_FILE','w'))"
    log "forced kill: $bid ($pids)"
  done < <(state_get apps)
}

disable_agents() {
  local label found=0
  while IFS= read -r label; do
    [[ -n "$label" ]] || continue
    found=1
    run launchctl bootout "gui/$(id -u)/$label" || log "bootout failed: $label"
    run launchctl disable "gui/$(id -u)/$label" || true
  done < <(state_get agents)
  if [[ $found -eq 0 ]]; then echo "no agents to disable"; fi
}

pause_services() {
  run sudo mdutil -a -i off || log "pause step failed: mdutil off"
  run sudo tmutil disable || log "pause step failed: tmutil disable"
  for label in com.apple.bird com.apple.cloudd com.apple.photoanalysisd; do
    run launchctl bootout "gui/$(id -u)/$label" || true
  done
}

apply_sysctl() {
  local mb="$1"
  run sudo sysctl "iogpu.wired_limit_mb=$mb" || log "sysctl step failed: apply $mb"
}

server_start() {
  run lms server start --port "$CFG_PORT"
  run lms load "$CFG_MODEL"
}

server_stop() { run lms server stop; }

server_health() {
  curl -sf -m 2 "http://localhost:$CFG_PORT/v1/models" >/dev/null 2>&1
}

cmd_on() {
  log "on: start"
  local wired; wired=$(wired_mb)   # fail before touching anything
  local before; before="$(free_ram_mb)MB"
  snapshot
  quit_apps
  disable_agents
  pause_services
  apply_sysctl "$wired"
  local after; after="$(free_ram_mb)MB"
  echo "free RAM before: $before  after: $after"
  server_start
  if [[ $DRY_RUN -eq 0 ]]; then
    for _ in $(seq 1 30); do server_health && break; sleep 2; done
    server_health && echo "API ready on localhost:$CFG_PORT" || echo "WARNING: API not responding"
  fi
  log "on: done"
}
cmd_off() {
  [[ -f "$STATE_FILE" ]] || die "no state file — nothing to restore"
  log "off: start"
  local fails=0

  server_stop || { log "restore step failed: server_stop"; fails=$((fails+1)); }

  local wired_prev
  wired_prev=$(state_get wired_limit_prev)
  if [[ ! "$wired_prev" =~ ^[0-9]+$ ]]; then
    log "restore warning: invalid wired_limit_prev '$wired_prev', using 0"
    wired_prev=0
  fi
  run sudo sysctl "iogpu.wired_limit_mb=$wired_prev" \
    || { log "restore step failed: sysctl restore"; fails=$((fails+1)); }

  local label
  while IFS= read -r label; do
    [[ -n "$label" ]] || continue
    { run launchctl enable "gui/$(id -u)/$label" \
        && { run launchctl bootstrap "gui/$(id -u)" "$HOME/Library/LaunchAgents/$label.plist" 2>/dev/null \
             || run launchctl kickstart "gui/$(id -u)/$label"; }; } \
      || { log "restore step failed: agent $label"; fails=$((fails+1)); }
  done < <(state_get agents)

  run sudo mdutil -a -i on || { log "restore step failed: mdutil on"; fails=$((fails+1)); }
  run sudo tmutil enable || { log "restore step failed: tmutil enable"; fails=$((fails+1)); }

  if [[ $RELAUNCH -eq 1 ]]; then
    local bid
    while IFS= read -r bid; do
      [[ -n "$bid" ]] || continue
      run open -b "$bid" || { log "restore step failed: relaunch $bid"; fails=$((fails+1)); }
    done < <(state_get apps)
  fi

  run rm -f "$STATE_FILE" || { log "restore step failed: rm state file"; fails=$((fails+1)); }

  log "off: done ($fails failed steps)"
  if [[ $fails -gt 0 ]]; then
    echo "restored with $fails failed steps (see log)"
  else
    echo "restored."
  fi
  echo "reboot fully resets any stubborn daemons."
}
cmd_status() {
  echo "model: $CFG_MODEL"
  echo "port: $CFG_PORT"
  echo "wired_limit_mb: $(wired_mb)"
  if server_health; then echo "server: up"; else echo "server: down"; fi
  echo "host: $(scutil --get LocalHostName 2>/dev/null || hostname).local"
  echo "free RAM: $(free_ram_mb)MB"
}
cmd_serve_stop() { server_stop; }

[[ $# -ge 1 ]] || usage
SUBCMD="$1"; shift
for arg in "$@"; do
  case "$arg" in
    --dry-run)  DRY_RUN=1 ;;
    --relaunch) RELAUNCH=1 ;;
    *) usage ;;
  esac
done

case "$SUBCMD" in
  on)         cmd_on ;;
  off)        cmd_off ;;
  status)     cmd_status ;;
  serve-stop) cmd_serve_stop ;;
  *)          usage ;;
esac
